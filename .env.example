APP_ENV=development
HTTP_ADDR=:8080
SHUTDOWN_TIMEOUT=10s

LOG_LEVEL=debug
LOG_FORMAT=text

# Dipakai saat API dijalankan langsung di host (make run).
# Di docker compose, DATABASE_URL dibentuk otomatis dari POSTGRES_* di bawah.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/backend_core?sslmode=disable

# Minimal 32 karakter. Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-secret-of-32-chars-min
JWT_TTL=24h
JWT_ISSUER=backend-core-go

RBAC_CACHE_TTL=5m

# Opsional: seed memberi role super_admin ke user dengan email ini (user harus sudah register).
SEED_ADMIN_EMAIL=

# Docker compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=backend_core
POSTGRES_PORT=5432
API_PORT=8080
